# docker compose / 로컬 실행용 환경 변수 예시. 복사해서 .env 로 쓰고 값은 직접 정하세요. (.env 는 git 에 올라가지 않습니다)

# 필수: JWT 서명 키 (32자 이상 무작위 문자열). 예) openssl rand -base64 48
JWT_SECRET=

# DB (docker compose 의 MySQL 컨테이너)
DB_PASSWORD=smartcollab
DB_ROOT_PASSWORD=change-me-root
DB_PORT=3307
APP_PORT=8080

# 선택: 앱 컨테이너 메모리 한도 (JVM 은 이 한도의 75% 를 힙으로 씀, 기본 2g)
# APP_MEM_LIMIT=2g

# 파일 저장소: local(기본, 컨테이너 볼륨) | azure
STORAGE_TYPE=local
AZURE_STORAGE_CONNECTION_STRING=

# 선택: Claude(Anthropic) API 키 — 있으면 문서 요약·번역(텍스트·PDF·Word)을 Claude 로 합니다 (ADR-0011).
# 없으면 요약은 단어 빈도 추출 요약, 번역은 아래 DeepL(텍스트만)로 동작합니다. 문서 내용이 Anthropic 으로 전송됩니다.
ANTHROPIC_API_KEY=
# 선택: 사용자별 하루 AI 토큰 한도(입력+출력)
# AI_TOKENS_PER_USER_PER_DAY=300000
# 선택: 모델·작업별 생각의 양 (실측으로 정한 기본값, DEPLOYMENT §2)
# AI_MODEL=claude-haiku-5-5
# AI_SUMMARY_EFFORT=low
# AI_TRANSLATION_EFFORT=medium
# 선택: 시간 상한(요약·응답 간격 / 번역 전체)과 서버 전체 동시 실행 수 (DEPLOYMENT §2)
# AI_TIMEOUT=120s
# AI_TRANSLATION_TIMEOUT=10m
# AI_MAX_CONCURRENT=8

# 선택: DeepL 번역 API 키 — AI 키가 없을 때 텍스트 문서 번역에 씁니다 (둘 다 없으면 번역 버튼이 비활성화됩니다)
DEEPL_API_KEY=
# 유료 요금제면 https://api.deepl.com
# DEEPL_API_URL=https://api-free.deepl.com

# 선택: 저장 공간 한도 (옛 버전·휴지통 포함)
# QUOTA_PERSONAL=1GB
# QUOTA_TEAM=5GB

# 선택: 데모 계정·샘플 데이터 생성 (DEMO_PASSWORD 는 영문+숫자 8자 이상)
# 체험 계정은 비밀번호가 로그인 화면에 공개되므로 체험 전용 배포에서만 켜세요. 매일 05:00(한국 시각) 초기화됩니다.
DEMO_ENABLED=false
DEMO_PASSWORD=
# DEMO_QUOTA=50MB
# 체험 계정마다 '파일 유형별 시험' 폴더(표본 16개) 만들기
# DEMO_SAMPLE_FILES=true

# 선택: 관리 전용 계정 — 계정 목록(아이디·이름·소속 팀·사용량·가입일)을 보고 계정을 삭제합니다 (ADR-0015)
# 아이디를 비우면 끔. 비밀번호는 12자 이상, 무작위로 만들어 따로 보관하세요. 예) openssl rand -base64 24
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 선택: 접근 코드 잠금 — 공개 데모에서 코드를 받은 사람만 들어오게 합니다 (ADR-0013, 해시 만드는 법은 DEPLOYMENT §3.2)
# GATE_CODES=이름:scrypt해시
# GATE_SECRET=
# GATE_HOURS=
# GATE_COOKIE_TTL=12h

# 그 밖의 설정(DB_POOL_SIZE·UPLOAD_MAX_FILE_SIZE·JWT_TTL 등)도 여기에 넣으면 앱에 전달됩니다 — 이름과 기본값은 DEPLOYMENT §2
